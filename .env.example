# 管理密钥：用于访问管理页面与 /api/* 接口，请务必修改为强随机串。
# 该环境变量优先于 config.yaml 中的 management_key 字段。
# 生成示例：openssl rand -hex 16
QUOTA_WARMER_MANAGEMENT_KEY=please-change-me

# 账号密钥（可选）：也可用环境变量注入，替代 config.yaml 中的 accounts[].api_key。
# 变量名为 QUOTA_WARMER_API_KEY_<PROVIDER>，provider 转大写、非字母数字字符替换为下划线。
# 示例：provider 为 volcano → QUOTA_WARMER_API_KEY_VOLCANO；provider 为 mock-claude → QUOTA_WARMER_API_KEY_MOCK_CLAUDE
# QUOTA_WARMER_API_KEY_VOLCENGINE=ark-xxxxxxxx
